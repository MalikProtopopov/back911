SECRET_KEY=ЗАМЕНИТЕ_НА_СГЕНЕРИРОВАННЫЙ_КЛЮЧ_МИНИМУМ_50_СИМВОЛОВ
DEBUG=False

# Database
# ⚠️ ОБЯЗАТЕЛЬНО: Заполните реальными значениями!
DB_NAME=website_911_db
DB_USER=postgres
