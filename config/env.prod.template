# Allowed Hosts
# ⚠️ ОБЯЗАТЕЛЬНО: Укажите все домены и IP адреса
# Через запятую, БЕЗ пробелов
# Добавьте IP адрес фронтенда, если фронт делает запросы напрямую по IP
ALLOWED_HOSTS=45.144.221.92,api.911.ru,www.911.ru,911.ru,89.169.1.53

# CORS
# ⚠️ ОБЯЗАТЕЛЬНО: Укажите все URL фронтенда
# Через запятую, БЕЗ пробелов, С протоколом (https:// или http://), С портом (если не 80/443)
# 
# Примеры:
#   - Фронт на порту 80: http://89.169.1.53
#   - Фронт на порту 3000: http://89.169.1.53:3000
#   - Фронт на порту 8080: http://89.169.1.53:8080
#   - Фронт на HTTPS (443): https://89.169.1.53
#
# ⚠️ ВАЖНО:
#   - ОБЯЗАТЕЛЬНО указывайте протокол (http:// или https://)
#   - ОБЯЗАТЕЛЬНО указывайте порт (если не 80 для http или 443 для https)
#   - НЕ добавляйте слэш в конце URL
#   - НЕ добавляйте пробелы после запятых
#
# Правильно:   CORS_ALLOWED_ORIGINS=http://89.169.1.53:3000,http://89.169.1.53
# Неправильно: CORS_ALLOWED_ORIGINS=89.169.1.53:3000 (нет протокола)
# Неправильно: CORS_ALLOWED_ORIGINS=http://89.169.1.53:3000/ (есть слэш)
# Неправильно: CORS_ALLOWED_ORIGINS=http://89.169.1.53:3000, http://89.169.1.53 (есть пробелы)
#
# ⚠️ ЗАМЕНИТЕ на реальные URL вашего фронтенда!
CORS_ALLOWED_ORIGINS=http://89.169.1.53:3000,http://89.169.1.53,http://45.144.221.92

